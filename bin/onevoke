#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any, NoReturn

from onevoke_config import (
    ARGPARSE_ZH,
    EXECUTION_AGENTS,
    LANGUAGES,
    REVIEW_AGENTS,
    REVIEW_ROLES,
    ConfigError,
    LocalizedArgumentParser,
    apply_language_argument,
    config_path,
    default_config,
    effective_config,
    language_text,
    load_config,
    save_config,
)
from agent_registry import (
    agent_label,
    agent_spec,
    memsearch_supported,
    review_wrapper_name,
    rules_mode,
    rules_path,
)

apply_language_argument(sys.argv[1:])
t = language_text
argparse._ = lambda message: t(ARGPARSE_ZH.get(message, message), message)


COMMANDS = (
    "onevoke",
    "kanban",
    *tuple(review_wrapper_name(name) for name in REVIEW_AGENTS),
    "merge-worktree-memory.py",
)
AGENT_LABELS = {name: agent_label(name) for name in EXECUTION_AGENTS}
MEMSEARCH_REPOSITORY = "https://github.com/zilliztech/memsearch.git"


class OnevokeError(Exception):
    pass


def color(code: str, text: str) -> str:
    if os.environ.get("NO_COLOR") or not sys.stderr.isatty():
        return text
    return f"\033[{code}m{text}\033[0m"


def warning(text: str) -> None:
    print(color("1;31", f"[!] {text}"), file=sys.stderr)


def success(text: str) -> None:
    print(color("1;32", f"[OK] {text}"), file=sys.stderr)


def find_commands() -> dict[str, str | None]:
    return {name: shutil.which(name) for name in COMMANDS}


VERSION_FAILED = t("版本检查失败", "version check failed")
TMUX_SESSION_HINT = "tmux new -A -s onevoke"


def agent_version(command: str) -> str:
    try:
        result = subprocess.run(
            [command, "--version"],
            text=True,
            capture_output=True,
            check=False,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return VERSION_FAILED
    output = (result.stdout or result.stderr).strip().splitlines()
    return output[0] if result.returncode == 0 and output else VERSION_FAILED


def agent_usable(state: dict[str, str | bool | None]) -> bool:
    """PATH 上有二进制且 --version 成功才算可用."""
    return bool(state.get("path")) and state.get("version") not in (None, VERSION_FAILED)


def find_agents() -> dict[str, dict[str, str | bool | None]]:
    agents: dict[str, dict[str, str | bool | None]] = {}
    for name in EXECUTION_AGENTS:
        command = shutil.which(name)
        agents[name] = {
            "path": command,
            "version": agent_version(command) if command else None,
            "execution": True,
            "review": name in REVIEW_AGENTS,
            "memsearch": memsearch_supported(name),
        }
    return agents


def _strip_comments_and_fences(text: str) -> str:
    """去掉 HTML 注释和 fenced code, 避免注释/示例里的标记造成假接入.

    未闭合的 `<!--` 一直删到文件末尾, 防止注释残片被当正文.
    """
    without_comments = re.sub(r"<!--.*?-->", "", text, flags=re.DOTALL)
    without_comments = re.sub(r"<!--.*\Z", "", without_comments, flags=re.DOTALL)
    lines: list[str] = []
    fence: str | None = None
    fence_len = 0
    for raw in without_comments.splitlines():
        stripped = raw.lstrip()
        if fence is None:
            for marker in ("```", "~~~"):
                if stripped.startswith(marker):
                    fence = marker[0]
                    fence_len = len(stripped) - len(stripped.lstrip(marker[0]))
                    break
            else:
                lines.append(raw)
            continue
        if stripped.startswith(fence * 3):
            closing = len(stripped) - len(stripped.lstrip(fence))
            if closing >= fence_len:
                fence = None
                fence_len = 0
    return "\n".join(lines)


_NEGATION_RE = re.compile(
    r"(禁用|废弃|停用|不要遵守|勿遵守|不遵守|不要使用|不使用|请勿使用|"
    r"未导入|尚未导入|不再生效|已失效|请忽略|"
    r"do not follow|do not use|disabled|deprecated|\bignore\b)",
    flags=re.IGNORECASE,
)


def _candidate_context(
    text: str, start: int, end: int, *, include_match: bool = True
) -> str:
    """取候选语境: 同段 + 前序/后序各最多 40 行, 捕捉前后否定说明.

    include_match=False 时不把候选正文本身计入语境, 避免合并式入口
    (如 ONEVOKE-AGENTS.md 内的「不使用其他长期分支模型」) 被自身否定词误伤.
    """
    before = text.rfind("\n\n", 0, start)
    after = text.find("\n\n", end)
    left = 0 if before < 0 else before + 2
    right = len(text) if after < 0 else after
    heading_before = text.rfind("\n#", left, start)
    if heading_before >= left:
        left = heading_before + 1
    heading_after = text.find("\n#", end, right)
    if heading_after >= 0:
        right = heading_after
    if include_match:
        section = text[left:right]
    else:
        section = text[left:start] + text[end:right]
    prior_lines = text[:start].splitlines()[-40:]
    following_lines = text[end:].splitlines()[:40]
    return "\n".join([section, *prior_lines, *following_lines])


def _claude_rules_import_present(text: str, entry: Path) -> bool:
    """Claude 只认独立行的 @ 导入, 且所在段落不得是否定/废弃语境."""
    candidates: set[str] = {"~/.agents/ONEVOKE-AGENTS.md"}
    try:
        resolved = entry.expanduser().resolve()
        candidates.add(str(entry))
        candidates.add(str(resolved))
        candidates.add(str(resolved).replace(str(Path.home()), "~", 1))
    except OSError:
        candidates.add(str(entry))
    body = _strip_comments_and_fences(text)
    offset = 0
    for raw in body.splitlines(keepends=True):
        line = raw.strip()
        line_start = offset
        offset += len(raw)
        if not line or line.startswith("#"):
            continue
        match = re.fullmatch(r"@([^\s]+)", line)
        if not match:
            continue
        ref = match.group(1).strip()
        accepted = ref in candidates
        if not accepted:
            try:
                accepted = (
                    Path(ref).expanduser().resolve() == entry.expanduser().resolve()
                )
            except OSError:
                accepted = False
        if not accepted:
            continue
        context = _candidate_context(body, line_start, offset)
        if _NEGATION_RE.search(context):
            continue
        return True
    return False


def _merged_rules_present(text: str, entry: Path) -> bool:
    """Codex/Grok 合并文件必须包含当前安装入口全文, 且外层语境不得是否定/废弃.

    入口正文自身可能含「不使用」等词 (见 ONEVOKE-AGENTS 分支模型条款),
    否定检查只看正文前后语境, 不扫描 expected 本身.
    """
    try:
        expected = entry.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        return False
    if not expected:
        return False
    body = _strip_comments_and_fences(text)
    index = body.find(expected)
    if index < 0:
        return False
    context = _candidate_context(
        body, index, index + len(expected), include_match=False
    )
    if _NEGATION_RE.search(context):
        return False
    return True


def rules_integration(agent: str) -> tuple[bool, str]:
    entry = Path.home() / ".agents" / "ONEVOKE-AGENTS.md"
    # 注册表路径形如 ~/.codex/AGENTS.md; 用 Path.home() 展开以兼容测试隔离.
    target = Path.home() / rules_path(agent).lstrip("~/").lstrip("/")
    if not target.exists() and not target.is_symlink():
        return False, t(f"未发现 {target}", f"not found: {target}")
    try:
        if target.is_symlink() and target.resolve() == entry.resolve():
            return True, str(target)
        text = target.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return False, t(f"无法读取 {target}", f"cannot read: {target}")
    if rules_mode(agent) == "import":
        integrated = _claude_rules_import_present(text, entry)
    else:
        integrated = _merged_rules_present(text, entry)
    if integrated:
        return True, str(target)
    return False, t(
        f"{target} 未导入或合并 ONEVOKE-AGENTS.md",
        f"{target} does not import or include ONEVOKE-AGENTS.md",
    )


def print_doctor() -> bool:
    healthy = True
    print(t("Onevoke 环境检查", "Onevoke environment check"), file=sys.stderr)
    for name, path in find_commands().items():
        if path:
            success(f"{name}: {path}")
        else:
            healthy = False
            warning(t(
                f"{name} 不在 PATH. 请把 ~/.local/bin 加入 PATH 后重新打开 shell.",
                f"{name} is not in PATH. Add ~/.local/bin to PATH and reopen your shell.",
            ))
    tmux = shutil.which("tmux")
    if tmux:
        success(f"tmux: {tmux}")
        if not os.environ.get("TMUX"):
            print(
                t(
                    f"[-] tmux: 已安装但当前不在 session. 启动: {TMUX_SESSION_HINT}",
                    f"[-] tmux: installed, but not in a session. Start one with: {TMUX_SESSION_HINT}",
                ),
                file=sys.stderr,
            )
    else:
        print(t(
            "[-] tmux: 未安装; 可在 welcome 中选择前台启动模式",
            "[-] tmux: not installed; welcome can select foreground mode",
        ), file=sys.stderr)

    agents = find_agents()
    print(t("\nAgent 能力:", "\nAgent capabilities:"), file=sys.stderr)
    for name, state in agents.items():
        if agent_usable(state):
            capabilities = [t("执行", "execution")]
            if state["review"]:
                capabilities.append(t("审核", "review"))
            if state["memsearch"]:
                capabilities.append("MemSearch")
            success(
                f"{AGENT_LABELS[name]}: {state['version']} "
                f"({', '.join(capabilities)}; {t('认证未验证', 'authentication not verified')})"
            )
        elif state["path"]:
            healthy = False
            warning(
                t(
                    f"{AGENT_LABELS[name]}: 位于 {state['path']}, 但 --version 失败; 不视为可用, 也不能在 welcome 中选择.",
                    f"{AGENT_LABELS[name]}: found at {state['path']}, but --version failed; it is unavailable and cannot be selected in welcome.",
                )
            )
        else:
            print(t(f"[-] {AGENT_LABELS[name]}: 未安装", f"[-] {AGENT_LABELS[name]}: not installed"), file=sys.stderr)
    if not any(agent_usable(state) for state in agents.values()):
        healthy = False
        warning(t("没有发现可执行 Agent; kanban 无法启动任务.", "No executable Agent found; kanban cannot start tasks."))
    if not any(agent_usable(agents[name]) for name in REVIEW_AGENTS):
        healthy = False
        warning(t("没有发现 Reviewer; 审核流程无法运行.", "No Reviewer found; reviews cannot run."))

    try:
        config = load_config()
    except ConfigError as error:
        warning(str(error))
        healthy = False
    else:
        if config["welcome_complete"]:
            success(t(f"配置: {config_path()}", f"config: {config_path()}"))
        else:
            print(t(f"[-] 配置: 尚未完成 ({config_path()})", f"[-] config: incomplete ({config_path()})"), file=sys.stderr)
        # 无论 welcome 是否完成, 都校验 effective_config 指向的实际资源.
        healthy = validate_configured_resources(config, agents) and healthy
    return healthy


def validate_configured_resources(
    config: dict[str, Any],
    agents: dict[str, dict[str, str | bool | None]],
) -> bool:
    """对生效配置逐项核对执行 Agent、Reviewer、wrapper 和 launcher."""
    healthy = True
    effective = effective_config(config)
    selected_agent = effective["kanban_agent"]
    selected_state = agents.get(selected_agent, {})
    if not agent_usable(selected_state):
        healthy = False
        warning(
            t(
                f"配置的执行 Agent 不可用: {selected_agent}; 请安装后重新运行 onevoke welcome --reset.",
                f"Configured execution Agent is unavailable: {selected_agent}; install it, then run onevoke welcome --reset.",
            )
        )

    for role in REVIEW_ROLES:
        reviewer = effective["reviewers"][role]
        reviewer_state = agents.get(reviewer, {})
        if not agent_usable(reviewer_state):
            healthy = False
            warning(
                t(
                    f"配置的 {role} Reviewer 不可用: {reviewer}; 请安装后重新运行 onevoke welcome --reset.",
                    f"Configured {role} Reviewer is unavailable: {reviewer}; install it, then run onevoke welcome --reset.",
                )
            )
            continue
        wrapper_name = review_wrapper_name(reviewer)
        if not shutil.which(wrapper_name):
            healthy = False
            warning(
                t(
                    f"配置的 {role} wrapper 不在 PATH: {wrapper_name}; 请把 ~/.local/bin 加入 PATH 或重新安装 Onevoke.",
                    f"Configured {role} wrapper is not in PATH: {wrapper_name}; add ~/.local/bin to PATH or reinstall Onevoke.",
                )
            )

    launcher = effective["launcher"]
    if launcher == "tmux":
        if not shutil.which("tmux"):
            healthy = False
            warning(
                t(
                    "配置的 launcher 是 tmux, 但 tmux 不在 PATH; 请安装 tmux 或运行 onevoke welcome --reset 改选 foreground.",
                    "The configured launcher is tmux, but tmux is not in PATH; install tmux or run onevoke welcome --reset and select foreground.",
                )
            )
        elif not os.environ.get("TMUX") and config.get("welcome_complete"):
            # 通用 tmux 段已给出唯一启动命令; 这里只在已完成配置时补充契约提示.
            print(
                t(
                    "[-] launcher=tmux 需要先进入上述 tmux session",
                    "[-] launcher=tmux requires entering the tmux session shown above",
                ),
                file=sys.stderr,
            )
    elif launcher == "foreground":
        # 仅在配置已完成时提示, 避免与通用 doctor 输出叠床架屋.
        if config.get("welcome_complete"):
            print(
                t(
                    "[-] launcher=foreground 需要交互终端 (stdin/stdout/stderr 均为 tty); 无 TTY 时改用 tmux 或在真实终端运行.",
                    "[-] launcher=foreground requires an interactive terminal (stdin/stdout/stderr must be TTYs); use tmux without a TTY or run in a real terminal.",
                ),
                file=sys.stderr,
            )

    return healthy


def ask_choice(prompt: str, choices: list[tuple[str, str]], default: str | None = None) -> str:
    if not choices:
        raise OnevokeError(t(f"没有可选项: {prompt}", f"No choices available: {prompt}"))
    while True:
        print(f"\n{color('1;36', prompt)}", file=sys.stderr)
        for index, (_, label) in enumerate(choices, 1):
            suffix = t(" (当前)", " (current)") if choices[index - 1][0] == default else ""
            print(f"  {index}. {label}{suffix}", file=sys.stderr)
        print(t(f"请选择 [1-{len(choices)}]: ", f"Choose [1-{len(choices)}]: "), end="", file=sys.stderr, flush=True)
        answer = sys.stdin.readline()
        if not answer:
            raise OnevokeError(t("输入已结束, 配置未更改", "Input ended; configuration was not changed"))
        answer = answer.strip()
        if answer.isdigit() and 1 <= int(answer) <= len(choices):
            return choices[int(answer) - 1][0]
        print(t("输入无效, 请重新选择.", "Invalid input; choose again."), file=sys.stderr)


def ask_yes_no(prompt: str, default: bool = False) -> bool:
    choices = [("yes", t("是", "Yes")), ("no", t("否", "No"))]
    selected = ask_choice(prompt, choices, "yes" if default else "no")
    return selected == "yes"


def install_memsearch_for(agent: str) -> None:
    if agent == "claude":
        print(
            t(
                "请在 Claude Code 内安装 MemSearch:",
                "Install MemSearch in Claude Code:",
            ),
            file=sys.stderr,
        )
        print("  /plugin marketplace add zilliztech/memsearch", file=sys.stderr)
        print("  /plugin install memsearch", file=sys.stderr)
        return

    source = Path(
        os.environ.get(
            "ONEVOKE_MEMSEARCH_SOURCE",
            Path.home() / ".local" / "share" / "onevoke" / "memsearch",
        )
    ).expanduser()
    installer = source / "plugins" / "codex" / "scripts" / "install.sh"
    try:
        source.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            ["git", "clone", MEMSEARCH_REPOSITORY, str(source)],
            check=True,
        )
        subprocess.run(["bash", str(installer)], check=True)
        success(t("MemSearch 安装命令已执行.", "The MemSearch installation commands completed."))
    except (OSError, subprocess.CalledProcessError) as error:
        warning(t(f"MemSearch 安装命令无法执行: {error}", f"Could not run the MemSearch installation commands: {error}"))


def install_tmux() -> bool:
    managers = (
        ("brew", ["brew", "install", "tmux"]),
        ("apt-get", ["apt-get", "install", "-y", "tmux"]),
        ("dnf", ["dnf", "install", "-y", "tmux"]),
        ("pacman", ["pacman", "-S", "--needed", "--noconfirm", "tmux"]),
        ("apk", ["apk", "add", "tmux"]),
    )
    selected = next((command for name, command in managers if shutil.which(name)), None)
    if selected is None:
        warning(t("没有找到受支持的包管理器, 请手动安装 tmux.", "No supported package manager was found; install tmux manually."))
        return False
    if selected[0] != "brew" and hasattr(os, "geteuid") and os.geteuid() != 0:
        sudo = shutil.which("sudo")
        if not sudo:
            warning(t(f"安装 tmux 需要管理员权限: {' '.join(selected)}", f"Installing tmux requires administrator privileges: {' '.join(selected)}"))
            return False
        selected = [sudo, *selected]
    print(t(f"即将运行: {' '.join(selected)}", f"About to run: {' '.join(selected)}"), file=sys.stderr)
    result = subprocess.run(selected, check=False)
    if result.returncode != 0 or not shutil.which("tmux"):
        warning(t("tmux 安装失败或安装后仍不在 PATH.", "tmux installation failed or tmux is still not in PATH."))
        return False
    success(t("tmux 已安装.", "tmux is installed."))
    return True


def configure_welcome(existing: dict[str, Any]) -> dict[str, Any]:
    agents = find_agents()
    for name, state in agents.items():
        if state["path"] and not agent_usable(state):
            warning(
                t(
                    f"{AGENT_LABELS[name]} 的 --version 失败, 已从可选列表排除: {state['path']}",
                    f"{AGENT_LABELS[name]} --version failed; excluded from choices: {state['path']}",
                )
            )
    execution_choices = [
        (name, f"{AGENT_LABELS[name]} ({state['version']})")
        for name, state in agents.items()
        if agent_usable(state)
    ]
    if not execution_choices:
        raise OnevokeError(
            t(
                f"没有发现可用的 Agent (--version 须成功). 请安装 {', '.join(AGENT_LABELS.values())} 之一.",
                f"No usable Agent found (--version must succeed). Install one of: {', '.join(AGENT_LABELS.values())}.",
            )
        )

    config = default_config()
    config["kanban_agent"] = ask_choice(
        t("kanban 默认用哪个 Agent 执行任务?", "Which Agent should kanban use by default?"),
        execution_choices,
        existing["kanban_agent"] if agent_usable(agents.get(existing["kanban_agent"], {})) else None,
    )

    review_choices = [
        (name, f"{AGENT_LABELS[name]} ({agents[name]['version']})")
        for name in REVIEW_AGENTS
        if agent_usable(agents[name])
    ]
    if not review_choices:
        raise OnevokeError(t(
            f"没有发现可用 Reviewer. 请安装 {', '.join(AGENT_LABELS[name] for name in REVIEW_AGENTS)} 之一.",
            f"No usable Reviewer found. Install one of: {', '.join(AGENT_LABELS[name] for name in REVIEW_AGENTS)}.",
        ))
    for role in REVIEW_ROLES:
        previous = existing["reviewers"][role]
        config["reviewers"][role] = ask_choice(
            t(f"{role} 使用哪个 Reviewer?", f"Which Reviewer should {role} use?"),
            review_choices,
            previous if agent_usable(agents.get(previous, {})) else None,
        )

    if shutil.which("tmux"):
        # doctor 已输出唯一启动命令; 这里不再重复.
        launcher_choices = [
            ("tmux", t("tmux 新窗口", "new tmux window")),
            ("foreground", t("当前终端前台运行", "foreground in this terminal")),
        ]
        config["launcher"] = ask_choice(
            t("kanban start 使用哪种启动方式?", "How should kanban start launch tasks?"),
            launcher_choices,
            existing["launcher"],
        )
    else:
        warning(t("未安装 tmux.", "tmux is not installed."))
        if ask_yes_no(t("是否现在安装 tmux?", "Install tmux now?"), default=False):
            if install_tmux():
                config["launcher"] = "tmux"
            elif ask_yes_no(t("tmux 未安装成功, 是否改用当前终端前台模式?", "tmux was not installed; use foreground mode in this terminal?"), default=True):
                config["launcher"] = "foreground"
            else:
                raise OnevokeError(t("没有可用启动方式, 配置未更改", "No launcher is available; configuration was not changed"))
        else:
            config["launcher"] = "foreground"
            print(t("已选择当前终端前台运行模式.", "Selected foreground mode in this terminal."), file=sys.stderr)

    selected_agent = config["kanban_agent"]
    integrated, detail = rules_integration(selected_agent)
    if integrated:
        success(t(f"{AGENT_LABELS[selected_agent]} 已接入 Onevoke 规则: {detail}", f"{AGENT_LABELS[selected_agent]} is connected to Onevoke rules: {detail}"))
    else:
        warning(t(f"{AGENT_LABELS[selected_agent]} 尚未接入 Onevoke 规则: {detail}", f"{AGENT_LABELS[selected_agent]} is not connected to Onevoke rules: {detail}"))
        print(t(
            "请按 README 的接入章节配置, welcome 不会覆盖你的全局规则文件.",
            "Follow the README integration section; welcome will not overwrite your global rules file.",
        ), file=sys.stderr)

    memory_agent = selected_agent if memsearch_supported(selected_agent) else None
    config["memsearch"]["enabled"] = False
    if memory_agent and ask_yes_no(
        t("是否使用 MemSearch?", "Use MemSearch?"), default=False
    ):
        config["memsearch"]["enabled"] = True
        install_memsearch_for(memory_agent)

    print(t("\n配置摘要:", "\nConfiguration summary:"), file=sys.stderr)
    print(f"  {t('执行 Agent', 'Execution Agent')}: {config['kanban_agent']}", file=sys.stderr)
    print(f"  {t('启动方式', 'Launcher')}: {config['launcher']}", file=sys.stderr)
    for role in REVIEW_ROLES:
        print(f"  {role}: {config['reviewers'][role]}", file=sys.stderr)
    print(f"  MemSearch: {t('启用', 'enabled') if config['memsearch']['enabled'] else t('未启用', 'disabled')}", file=sys.stderr)
    print(
        color("1;33", t(
            "注意: kanban start 会使用 Agent 的免确认模式执行已确认任务.",
            "Note: kanban start uses the Agent's no-confirmation mode for confirmed tasks.",
        )),
        file=sys.stderr,
    )
    if not ask_yes_no(t("保存以上配置?", "Save this configuration?"), default=True):
        raise OnevokeError(t("用户取消, 配置未更改", "Cancelled; configuration was not changed"))
    config["welcome_complete"] = True
    return config


def command_welcome(reset: bool) -> int:
    print_doctor()
    try:
        existing = load_config()
    except ConfigError as error:
        warning(str(error))
        if not reset:
            print(t("使用 onevoke welcome --reset 重新创建配置.", "Run onevoke welcome --reset to recreate the configuration."), file=sys.stderr)
            return 1
        existing = default_config()

    if existing["welcome_complete"] and not reset:
        success(t(f"welcome 已完成: {config_path()}", f"welcome is complete: {config_path()}"))
        print(t("如需重新选择, 运行 onevoke welcome --reset.", "Run onevoke welcome --reset to choose again."), file=sys.stderr)
        return 0
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        warning(t("当前没有交互终端, welcome 未完成.", "No interactive terminal is available; welcome is incomplete."))
        print(t("请在终端运行 onevoke welcome.", "Run onevoke welcome in a terminal."), file=sys.stderr)
        return 0
    try:
        configured = configure_welcome(existing)
        path = save_config(configured)
    except (OnevokeError, ConfigError, OSError, UnicodeError) as error:
        warning(str(error))
        return 1
    success(t(f"配置已保存: {path}", f"Configuration saved: {path}"))
    return 0


def command_review(arguments: list[str]) -> NoReturn:
    if len(arguments) < 5 or len(arguments) > 6:
        raise OnevokeError(
            t(
                "用法: onevoke review <worktree> <base> <commit> <role> <task> [context]",
                "usage: onevoke review <worktree> <base> <commit> <role> <task> [context]",
            )
        )
    role = arguments[3]
    aliases = {name.lower(): name for name in REVIEW_ROLES}
    aliases["codesecurityanalyst"] = "CSA"
    normalized = aliases.get(role.lower())
    if not normalized:
        raise OnevokeError(t(f"不支持的 Reviewer 角色: {role}", f"Unsupported Reviewer role: {role}"))
    config = effective_config(load_config())
    reviewer = config["reviewers"][normalized]
    wrapper_name = review_wrapper_name(reviewer)
    wrapper = shutil.which(wrapper_name)
    if not wrapper:
        raise OnevokeError(t(f"Reviewer wrapper 不在 PATH: {wrapper_name}", f"Reviewer wrapper is not in PATH: {wrapper_name}"))
    arguments[3] = normalized
    os.execv(wrapper, [wrapper, *arguments])


def print_config(config: dict[str, Any]) -> None:
    effective = effective_config(config)
    status = t("已完成", "complete") if config["welcome_complete"] else t("未完成", "incomplete")
    print(f"welcome: {status}")
    print(f"kanban agent: {effective['kanban_agent']}")
    print(f"launcher: {effective['launcher']}")
    for role in REVIEW_ROLES:
        print(f"{role}: {effective['reviewers'][role]}")
    print(f"MemSearch: {t('启用', 'enabled') if effective['memsearch']['enabled'] else t('未启用', 'disabled')}")


# ---------------------------------------------------------------------------
# M3: token 节省 — 规则摘要与项目上下文缓存
# ---------------------------------------------------------------------------

SUMMARY_HEADING = re.compile(r"^#{2,4}\s+(.+)$")
BULLET_RE = re.compile(r"^-\s+(.+)$")
_SUMMARY_SKIP = {"SUMMARY.md", "AGENTS.md", "ONEVOKE-AGENTS.md", "CLAUDE.md"}
_LINE_LIMIT = 100


def _truncate(text: str) -> str:
    return text if len(text) <= _LINE_LIMIT else text[:_LINE_LIMIT - 1] + "…"


def summarize_rule_file(path: Path) -> list[str]:
    """把单个分册压成摘要行: 标题 + 各小节前 2 条要点."""
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return [f"- (无法读取 {path.name})"]
    lines: list[str] = []
    section = ""
    bullets = 0
    for raw in text.splitlines():
        heading = SUMMARY_HEADING.match(raw)
        if heading:
            if section and bullets == 0:
                lines.append(f"  - ({t('无要点', 'no bullets')})")
            section = heading.group(1).strip()
            if section.startswith("## "):
                continue
            lines.append(f"- {_truncate(section)}")
            bullets = 0
            continue
        bullet = BULLET_RE.match(raw)
        if bullet and section:
            if bullets < 2:
                lines.append(f"  - {_truncate(bullet.group(1).strip())}")
            bullets += 1
    if section and bullets == 0:
        lines.append(f"  - ({t('无要点', 'no bullets')})")
    return lines


def command_compile_rules(source: str | None) -> int:
    """从规则目录生成 SUMMARY.md: 每个分册的标题 + 要点, 供任务 session 先读."""
    rules_dir = Path(source).expanduser().resolve() if source else (Path.home() / ".agents")
    if not rules_dir.is_dir():
        raise OnevokeError(t(f"规则目录不存在: {rules_dir}", f"Rules directory does not exist: {rules_dir}"))
    output_path = rules_dir / "SUMMARY.md"
    out: list[str] = [
        "# Onevoke 规则摘要",
        "",
        t(
            "自动生成 (onevoke compile-rules). 任务开始时先读本摘要, 需要细节再读对应分册.",
            "Auto-generated (onevoke compile-rules). Read this summary first, then the relevant booklet for details.",
        ),
        "",
    ]
    for rule in sorted(rules_dir.glob("*.md")):
        if rule.name in _SUMMARY_SKIP:
            continue
        out.append(f"## {rule.name}")
        out.append(f"- {t('入口', 'entry')}: `~/.agents/{rule.name}`")
        out.extend(summarize_rule_file(rule))
        out.append("")
    output_path.write_text("\n".join(out), encoding="utf-8")
    print(output_path)
    return 0


_INDEX_SKIP_DIRS = {
    ".git", ".hg", ".svn", ".onevoke", "node_modules", "__pycache__",
    "venv", ".venv", "dist", "build", "target", ".idea", ".vscode", ".tmp",
}
_INDEX_DEPTH = 4
_INDEX_MAX_FILES = 400
_INDEX_ENTRY_FILES = (
    "README.md", "readme.md", "pyproject.toml", "package.json",
    "Cargo.toml", "go.mod", "CMakeLists.txt", "Makefile", "AGENTS.md", "CLAUDE.md",
)


def command_index(project: str | None) -> int:
    """生成 .onevoke/context.md: 目录树 + 入口文件摘要, 让新 session 免冷启动探索."""
    root = Path(project).expanduser().resolve() if project else Path.cwd().resolve()
    if not root.is_dir():
        raise OnevokeError(t(f"项目目录不存在: {root}", f"Project directory does not exist: {root}"))
    out_dir = root / ".onevoke"
    out_dir.mkdir(parents=True, exist_ok=True)
    output_path = out_dir / "context.md"
    out: list[str] = [
        f"# {t('项目上下文', 'Project context')} ({root.name})",
        "",
        t(
            "由 onevoke index 生成, 供任务 session 快速建立全局认识; 仓库结构变化后重新运行.",
            "Generated by onevoke index; read to bootstrap a task session. Re-run after structure changes.",
        ),
        "",
    ]

    readme = root / "README.md"
    if not readme.is_file():
        readme = root / "readme.md"
    if readme.is_file():
        out.append(f"## README ({t('前 40 行', 'first 40 lines')})")
        try:
            lines = readme.read_text(encoding="utf-8").splitlines()[:40]
            out.extend(f"> {_truncate(line)}" if line.strip() else ">" for line in lines)
        except (OSError, UnicodeError):
            out.append(f"> ({t('无法读取 README', 'cannot read README')})")
        out.append("")

    out.append(f"## {t('目录树', 'Directory tree')} (深度 {_INDEX_DEPTH})")
    file_count = 0
    for current, dirs, files in os.walk(root):
        dirs[:] = sorted(
            d for d in dirs
            if d not in _INDEX_SKIP_DIRS and not d.startswith(".")
        )
        depth = len(Path(current).relative_to(root).parts)
        if depth > _INDEX_DEPTH:
            dirs[:] = []
            continue
        indent = "  " * depth
        out.append(f"{indent}{Path(current).name}/")
        for name in sorted(files):
            if file_count >= _INDEX_MAX_FILES:
                out.append(f"{indent}  … ({t('文件过多, 已截断', 'too many files, truncated')})")
                break
            file_count += 1
            out.append(f"{indent}  {name}")
    out.append("")

    out.append(f"## {t('入口文件', 'Entry files')}")
    for name in _INDEX_ENTRY_FILES:
        entry = root / name
        if not entry.is_file():
            continue
        try:
            preview = " ".join(entry.read_text(encoding="utf-8").split())[:_LINE_LIMIT]
        except (OSError, UnicodeError):
            preview = f"({t('无法读取', 'cannot read')})"
        out.append(f"- `{name}`: {_truncate(preview)}")
    out.append("")

    output_path.write_text("\n".join(out), encoding="utf-8")
    print(output_path)
    return 0


def parser() -> argparse.ArgumentParser:
    result = LocalizedArgumentParser(prog="onevoke", description=t("Onevoke 配置与诊断", "Onevoke configuration and diagnostics"))
    result.add_argument("--lang", choices=LANGUAGES, help=t("覆盖输出语言", "override the output language"))
    commands = result.add_subparsers(dest="command", required=True)
    welcome = commands.add_parser("welcome", help=t("检查环境并完成首次配置", "check the environment and complete initial setup"))
    welcome.add_argument("--reset", action="store_true", help=t("重新执行配置向导", "run the setup wizard again"))
    commands.add_parser("doctor", help=t("检查 Onevoke 环境", "check the Onevoke environment"))
    config = commands.add_parser("config", help=t("输出当前配置", "print the current configuration"))
    config.add_argument("--json", action="store_true", help=t("以 JSON 输出", "output JSON"))
    review = commands.add_parser("review", help=t("按配置选择 Reviewer wrapper", "select a Reviewer wrapper from configuration"))
    review.add_argument("arguments", nargs=argparse.REMAINDER, metavar=t("参数", "arguments"))
    compile_rules = commands.add_parser("compile-rules", help=t("从规则目录生成 SUMMARY.md 摘要", "generate SUMMARY.md from the rules directory"))
    compile_rules.add_argument("--source", metavar=t("规则目录", "rules dir"), help=t("规则目录, 默认 ~/.agents", "rules directory; defaults to ~/.agents"))
    index = commands.add_parser("index", help=t("生成 .onevoke/context.md 项目上下文", "generate .onevoke/context.md project context"))
    index.add_argument("project", nargs="?", metavar=t("项目目录", "project dir"), help=t("项目根目录, 默认当前目录", "project root; defaults to the current directory"))
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "welcome":
            return command_welcome(args.reset)
        if args.command == "doctor":
            return 0 if print_doctor() else 1
        if args.command == "config":
            config = load_config()
            if args.json:
                print(json.dumps(config, ensure_ascii=False, indent=2))
            else:
                print_config(config)
            return 0
        if args.command == "review":
            command_review(args.arguments)
        if args.command == "compile-rules":
            return command_compile_rules(args.source)
        if args.command == "index":
            return command_index(args.project)
        return 0
    except KeyboardInterrupt:
        print(t("\nonevoke: 用户取消, 配置未更改", "\nonevoke: cancelled; configuration was not changed"), file=sys.stderr)
        return 130
    except (OnevokeError, ConfigError, OSError, UnicodeError) as error:
        print(f"onevoke: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
