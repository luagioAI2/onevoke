#!/usr/bin/env python3

"""deepseek — llm-agent 的 DeepSeek 薄壳.

把 provider 固定为 deepseek 后转发到 llm_agent; 满足 Onevoke 对 Agent
二进制的契约: --version 能力探测, exec 任务执行, review 只读审核.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from llm_agent import run_provider_shim  # noqa: E402


if __name__ == "__main__":
    sys.exit(run_provider_shim("deepseek"))
